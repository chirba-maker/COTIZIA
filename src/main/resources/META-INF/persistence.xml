<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.0" xmlns="https://jakarta.ee/xml/ns/persistence" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">
    <!--
        Persistence configuration is retained for future migration to JPA.
        Current production code uses JDBC with HikariCP and does not require a
        persistence provider at runtime.
    -->
    <persistence-unit name="my_persistence_unit" transaction-type="RESOURCE_LOCAL">
        <description>Placeholder persistence unit. JDBC/HikariCP is the active persistence layer.</description>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>
        <properties>
            <property name="jakarta.persistence.schema-generation.database.action" value="none"/>
        </properties>
    </persistence-unit>
</persistence>
