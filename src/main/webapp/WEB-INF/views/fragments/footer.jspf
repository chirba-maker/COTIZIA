<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<!-- Modal de Confirmation de Suppression Global -->
<div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-labelledby="deleteConfirmModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteConfirmModalLabel">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>Confirmation
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 text-center">
                <div class="mb-3">
                    <i id="confirmIcon" class="bi bi-exclamation-octagon text-danger" style="font-size: 3rem;"></i>
                </div>
                <p id="confirmMessage" class="fs-5">Êtes-vous sûr de vouloir effectuer cette action pour :</p>
                <h4 id="entityNameToConfirm" class="text-primary mb-3"></h4>
                <p class="text-muted small">
                    <i class="bi bi-info-circle me-1"></i> Cette action peut être irréversible.
                </p>
            </div>
            <div class="modal-footer bg-light border-0 justify-content-center">
                <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">
                    <i class="bi bi-x-lg me-1"></i> Annuler
                </button>
                <a id="confirmActionBtn" href="#" class="btn btn-danger px-4">
                    <i class="bi bi-check-lg me-1"></i> <span id="confirmActionText">Confirmer</span>
                </a>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    /**
     * Ouvre la modal de confirmation
     * @param url L'URL vers laquelle rediriger en cas de confirmation
     * @param name Nom de l'entité concernée (ex: Nom de l'utilisateur)
     * @param action Libellé de l'action (par défaut "Supprimer")
     * @param icon Icone à afficher (optionnel)
     */
    function confirmDelete(url, name, action = "Supprimer définitivement", icon = "bi-exclamation-octagon") {
        const modal = new bootstrap.Modal(document.getElementById('deleteConfirmModal'));
        document.getElementById('entityNameToConfirm').textContent = name;
        document.getElementById('confirmActionBtn').href = url;
        document.getElementById('confirmActionText').textContent = action;
        
        const iconElem = document.getElementById('confirmIcon');
        iconElem.className = "bi " + icon + " text-danger";
        
        modal.show();
    }
</script>
